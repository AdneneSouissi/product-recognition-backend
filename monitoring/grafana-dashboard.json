{
  "title": "Product Recognition API",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Requests per endpoint/status",
      "targets": [
        {
          "expr": "sum by (endpoint,status) (rate(requests_total[5m]))",
          "legendFormat": "{{endpoint}} {{status}}"
        }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Request latency p95 (s)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(request_latency_seconds_bucket[5m])) by (le,endpoint))",
          "legendFormat": "{{endpoint}} p95"
        }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 }
    },
    {
      "type": "stat",
      "title": "5xx error rate",
      "targets": [
        {
          "expr": "sum(rate(requests_total{status=~\"5..\"}[5m]))"
        }
      ],
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 16 }
    }
  ],
  "templating": { "list": [] }
}
